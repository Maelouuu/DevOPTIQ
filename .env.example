# =====================================================================
#  DevOPTIQ — Modèle de configuration locale
#  Copie ce fichier en `.env` à la racine puis remplis les valeurs.
#  Le `.env` N'EST JAMAIS commité (il est dans .gitignore). Ne le partage
#  que via un canal sécurisé (gestionnaire de mots de passe).
# =====================================================================

# ---------------------------------------------------------------------
#  Base de données
# ---------------------------------------------------------------------
# - En LOCAL : laisse DATABASE_URL VIDE/commenté → l'app utilise SQLite
#   automatiquement (Code/instance/optiq.db, créé tout seul). Zéro setup.
# - Pour viser Neon : colle l'URL "pooled" de TA branche Neon (staging-mv),
#   jamais celle de la prod. Format :
#   postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=

# Clé secrète Flask (sessions / cookies). En local n'importe quelle chaîne suffit.
# Génère-en une vraie avec :  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-en-local

# Port HTTP (8080 par défaut, comme Cloud Run)
PORT=8080

# ---------------------------------------------------------------------
#  IA — OpenAI (chatbot, import IA, propositions de compétences…)
# ---------------------------------------------------------------------
# Sans clé, ces fonctions renvoient un fallback "à blanc" (l'app tourne quand même).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHATBOT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------
#  IA — Anthropic Claude (import IA carto, génération assistée)
# ---------------------------------------------------------------------
# Le code accepte ANTHROPIC_API_KEY OU ANTHROPIC_KEY.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------
#  Projection métier — API ROME 4.0 / France Travail (OAuth2)
# ---------------------------------------------------------------------
# Identifiants d'application France Travail (francetravail.io).
# Sans eux, seule la page "Projection métier" est dégradée.
ROME_CLIENT_ID=
ROME_CLIENT_SECRET=

# ---------------------------------------------------------------------
#  Email (réinitialisation de mot de passe, notifications)
# ---------------------------------------------------------------------
# ⚠️ Ne mets PAS de vrai mot de passe applicatif ici si tu push : reste en .env local.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=afdec.enterprise.services@gmail.com
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=afdec.enterprise.services@gmail.com

# ---------------------------------------------------------------------
#  Cloud (optionnel en local, injecté par Cloud Run en prod/staging)
# ---------------------------------------------------------------------
# FLASK_ENV=local
# GOOGLE_CLOUD_PROJECT=
