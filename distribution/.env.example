# ============================================================
#  OptiqFluent — Configuration d'instance (beta test)
#  Copier ce fichier en `.env` à côté du docker-compose.yml,
#  remplir chaque section, puis : docker compose up -d
# ============================================================

# ------------------------------------------------------------
# 1) Base de données PostgreSQL
# ------------------------------------------------------------
# Option A (par défaut, recommandée pour le test) : le PostgreSQL embarqué du
# docker-compose. Choisissez simplement un mot de passe fort ci-dessous —
# vos données restent intégralement sur votre machine.
POSTGRES_PASSWORD=changez-moi-mot-de-passe-fort

# Option B : un PostgreSQL hébergé par vos soins (Neon, RDS, serveur interne…) —
# modifiez la valeur DATABASE_URL directement dans docker-compose.yml (bloc
# `environment` du service app) et supprimez-y le service `db`.
#
# Dans les deux cas, les tables sont créées automatiquement au premier démarrage.

# ------------------------------------------------------------
# 2) Sécurité de session (OBLIGATOIRE)
# ------------------------------------------------------------
# Chaîne aléatoire longue (64+ caractères). Pour en générer une :
#   openssl rand -hex 32
SECRET_KEY=

# ------------------------------------------------------------
# 3) Premier compte administrateur (première installation)
# ------------------------------------------------------------
# Créé automatiquement au premier démarrage si la base ne contient aucun
# utilisateur. Connectez-vous ensuite avec ces identifiants pour créer les
# autres comptes. (Ignoré dès qu'un utilisateur existe.)
ADMIN_EMAIL=admin@votre-entreprise.fr
ADMIN_PASSWORD=changez-moi-a-la-premiere-connexion
# ADMIN_FIRST_NAME=Prénom
# ADMIN_LAST_NAME=Nom

# ------------------------------------------------------------
# 4) Intelligence artificielle (compte OpenAI requis)
# ------------------------------------------------------------
# Les fonctions IA (chatbot, imports, propositions de compétences, traductions)
# utilisent l'API OpenAI avec VOTRE clé : créez un compte sur
# https://platform.openai.com, ajoutez un moyen de paiement, générez une clé
# API et fixez un plafond mensuel de dépense (Settings → Limits).
# Vos contenus transitent par votre compte OpenAI, pas par AFDEC.
OPENAI_API_KEY=sk-...
# OPENAI_CHATBOT_MODEL=gpt-4o-mini

# Facultatif — clé Anthropic (fonction d'analyse Visio de secours uniquement) :
# ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# 5) Envoi d'emails — réinitialisation de mot de passe (compte Google)
# ------------------------------------------------------------
# Utilisé uniquement pour envoyer les emails « mot de passe oublié ».
# Avec un compte Google/Gmail (ou Google Workspace) :
#   1. Activez la validation en deux étapes sur le compte,
#   2. Créez un « mot de passe d'application » : https://myaccount.google.com/apppasswords
#   3. Renseignez ci-dessous l'adresse du compte et ce mot de passe d'application
#      (PAS le mot de passe habituel du compte).
# Si cette section reste vide, l'application fonctionne normalement mais la
# réinitialisation de mot de passe par email est désactivée.
MAIL_USERNAME=notifications@votre-entreprise.fr
MAIL_PASSWORD=
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_DEFAULT_SENDER=

# ------------------------------------------------------------
# 6) Licence OptiqFluent (fournie par AFDEC)
# ------------------------------------------------------------
# Déposez le fichier `optiqfluent.lic` fourni par AFDEC dans le dossier
# `license/` à côté du docker-compose.yml (créez-le si besoin).
# Lors d'un renouvellement, remplacez simplement le fichier : il est pris en
# compte sans redémarrage.

# ------------------------------------------------------------
# 7) Réglages serveur (facultatif)
# ------------------------------------------------------------
# WEB_CONCURRENCY=2        # nombre de workers HTTP
# DB_POOL_SIZE=5           # pool de connexions DB (5 si PostgreSQL local)
# DB_MAX_OVERFLOW=5
