# ============================================================
#  OptiqFluent — Configuration minimale
#  Copier ce fichier en `.env`, choisir un mot de passe, puis :
#      docker compose up -d
#  Tout le reste (licence, base, clé IA, email, administrateur)
#  se configure dans le navigateur au premier démarrage :
#      http://<machine>:8080
# ============================================================

# Mot de passe de la base PostgreSQL intégrée (choisissez une valeur forte)
POSTGRES_PASSWORD=changez-moi-mot-de-passe-fort

# ------------------------------------------------------------
# Avancé (facultatif) — configuration SANS l'assistant :
# décommentez pour fournir les valeurs directement par variables
# d'environnement ; l'assistant est alors ignoré pour ces champs.
# ------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# SECRET_KEY=            # openssl rand -hex 32
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# MAIL_USERNAME=         # l'adresse du compte d'envoi, en entier
# MAIL_PASSWORD=         # mot de passe d'application Google (PAS celui du compte)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_DEFAULT_SENDER=OptiqFluent <adresse@exemple.com>
#   Ce que voit le destinataire. Sans cette ligne, il lit l'adresse brute.
#   L'adresse entre chevrons doit être CELLE du compte d'envoi : Gmail refuse
#   d'expédier au nom d'une adresse qu'il n'authentifie pas.
# WEB_CONCURRENCY=2
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
